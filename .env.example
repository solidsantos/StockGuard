# StockGuard 1.0 - configurações locais de exemplo (nunca envie a sua .env)
STOCKGUARD_DB=stockguard.sqlite3

# Modo A: IA online OpenAI-compatible (Groq, Together ou outro)
AI_MODE=openai_compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20

# Modo B: agente online próprio que aceite POST {question, context, sources, instructions}
# e devolva JSON {"answer":"..."}. Configure AI_MODE=agent_http e:
AI_AGENT_URL=
AI_AGENT_API_KEY=
